{
  "name": "filipp-tg",
  "version": "0.39.0",
  "license": "MIT",
  "scripts": {
    "start:memes-bot": "nx serve memes-bot",
    "build:memes-bot": "nx build memes-bot",
    "test:memes-bot": "nx test memes-bot",
    "coverage": "nx test memes-bot --codeCoverage",
    "coverage:report": "node tools/coverage/generate-coverage-report.mjs",
    "coverage:all": "npm run coverage && npm run coverage:report",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm tests",
    "e2e:docker": "docker compose -f docker-compose.test.yml run --rm e2e",
    "deps:build": "bash tools/ci/build-base.sh",
    "docker:memes-bot:build": "docker build -f ./apps/memes-bot/Dockerfile -t cr.yandex/crp8g8jm3p8d780a8hk3/telegram-bot:${VERSION:-dev} .",
    "docker:memes-bot:push": "docker push cr.yandex/crp8g8jm3p8d780a8hk3/telegram-bot:${VERSION:-dev}",
    "docker:memes-bot:publish": "npm run docker:memes-bot:build && npm run docker:memes-bot:push",
    "troll:audit": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' apps/memes-bot/tools/troll-audit/run.ts",
    "troll:audit:selfcheck": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' apps/memes-bot/tools/troll-audit/selfcheck-test.ts",
    "troll:audit:reviewer": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' apps/memes-bot/tools/troll-audit/reviewer-test.ts",
    "troll:audit:log": "ts-node --transpile-only -O '{\"module\":\"commonjs\"}' apps/memes-bot/tools/troll-audit/verify-log.ts",
    "troll:audit:types": "tsc -p apps/memes-bot/tools/troll-audit/tsconfig.json"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "3.985.0",
    "@aws-sdk/lib-storage": "3.985.0",
    "@grammyjs/auto-retry": "2.0.2",
    "@grammyjs/conversations": "2.1.1",
    "@grammyjs/menu": "1.5.0",
    "@grammyjs/runner": "2.0.3",
    "@grammyjs/storage-typeorm": "2.6.0",
    "@grammyjs/transformer-throttler": "1.2.1",
    "@nestjs/axios": "3.0.0",
    "@nestjs/bull": "0.6.2",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "2.2.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "2.2.2",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "9.0.1",
    "axios": "1.4.0",
    "bull": "4.10.3",
    "date-fns": "2.29.3",
    "date-fns-tz": "2.0.0",
    "form-data": "3.0.1",
    "grammy": "1.46.0",
    "imghash": "0.0.9",
    "lodash-es": "4.17.21",
    "nestjs-telegraf": "2.6.3",
    "pg": "8.9.0",
    "plural-ru": "2.0.2",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "telegraf": "4.11.2",
    "telegram": "2.15.5",
    "tslib": "^2.3.0",
    "typeorm": "0.3.11"
  },
  "devDependencies": {
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@nrwl/cli": "14.5.10",
    "@nrwl/eslint-plugin-nx": "14.5.10",
    "@nrwl/jest": "14.5.10",
    "@nrwl/linter": "14.5.10",
    "@nrwl/nest": "14.5.10",
    "@nrwl/node": "14.5.10",
    "@nrwl/workspace": "14.5.10",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bull": "4.10.0",
    "@types/cron": "2.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "27.4.1",
    "@types/node": "16.11.7",
    "@typescript-eslint/eslint-plugin": "^5.29.0",
    "@typescript-eslint/parser": "^5.29.0",
    "eslint": "~8.15.0",
    "eslint-config-prettier": "8.1.0",
