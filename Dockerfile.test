# syntax=docker/dockerfile:1.7
# Контейнер окружения тестов: unit + e2e. Собирается FROM базового образа с
# зависимостями (Dockerfile.deps), поэтому устанавка пакетов не повторяется.
#
# Сборка: docker build -f Dockerfile.test --build-arg DEPS_IMAGE=<base> -t memes-bot-tests .
# Запуск: docker run --rm memes-bot-tests
ARG DEPS_IMAGE=cr.yandex/crp8g8jm3p8d780a8hk3/telegram-bot-deps:node20
FROM ${DEPS_IMAGE}

WORKDIR /usr/src/app

# Исходники (node_modules/dist/coverage исключены .dockerignore).
COPY . .

CMD ["npx", "nx", "test", "memes-bot", "--codeCoverage"]
