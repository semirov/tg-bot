{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "target": "es2015",
    "lib": ["es2020.bigint"]
  },
  "exclude": ["jest.config.ts", "jest-e2e.config.ts", "**/*.spec.ts", "**/*.test.ts", "test/**", "tools/**"],
  "include": ["**/*.ts"]
}
